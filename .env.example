# ==============================================================================
# StayFinder Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual local configuration.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Database Connection (MySQL 8.4 - Least Privilege)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stayfinder_db
DB_USERNAME=stayfinder_app
DB_PASSWORD=your_app_password_here

# Migration Database Connection (Flyway - DDL Privileges)
DB_MIGRATION_USERNAME=stayfinder_migration
DB_MIGRATION_PASSWORD=your_migration_password_here

# Server Port
SERVER_PORT=8080

# Allowed CORS Origins (Comma-separated for React Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
